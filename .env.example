# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o ".env" com segredos reais (já está no .gitignore).

# ---------------------------------------------------------------------------
# Cliente (expostos ao navegador — build-time, via Vite). Seguros de expor:
# são a URL pública e a "anon key", que por padrão não tem nenhum acesso
# (RLS habilitado sem policies nas tabelas da pesquisa).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="http://localhost:8000"
VITE_SUPABASE_PUBLISHABLE_KEY="cole-aqui-o-ANON_KEY-gerado"

# ---------------------------------------------------------------------------
# Servidor (nunca expostos ao navegador — usados só em server functions/SSR)
# ---------------------------------------------------------------------------
SUPABASE_URL="http://kong:8000"
SUPABASE_PUBLISHABLE_KEY="cole-aqui-o-ANON_KEY-gerado"
# Chave com privilégio total (bypassa RLS). Só existe no servidor.
SUPABASE_SERVICE_ROLE_KEY="cole-aqui-o-SERVICE_ROLE_KEY-gerado"

# Senha do painel /admin. Validada no servidor (server function) — troque o
# valor abaixo E a constante ADMIN_PASSWORD em src/routes/admin.tsx (o gate
# visual do lado do cliente) para os dois ficarem sincronizados.
ADMIN_PASSWORD="guivos2026"

# ---------------------------------------------------------------------------
# Stack Supabase self-hosted (docker-compose.yml) — gere estes valores com:
#   node deploy/generate-keys.mjs
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD="troque-esta-senha"
JWT_SECRET="troque-este-segredo-com-32-bytes-aleatorios"
ANON_KEY="mesmo-valor-de-VITE_SUPABASE_PUBLISHABLE_KEY-acima"
SERVICE_ROLE_KEY="mesmo-valor-de-SUPABASE_SERVICE_ROLE_KEY-acima"
AUTHENTICATOR_PASSWORD="troque-esta-senha-tambem"

# Porta exposta do gateway Kong (API REST do Supabase self-hosted)
KONG_HTTP_PORT=8000

# Porta exposta da aplicação
APP_PORT=3000
